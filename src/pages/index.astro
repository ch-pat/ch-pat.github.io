---
import '../styles/global.css';

const experience = [
  {
    period: '2022 — Present',
    role: 'Advanced Software Engineer',
    company: 'NTT DATA',
    description:
      'API developer for Generali JenIoT, building Python and Node.js Cloud Functions with unit and integration tests. Developed Apigee proxies, coordinated a zero-downtime service switch, refactored claims reporting, and optimized cloud and query costs.',
  },
  {
    period: '2021 — 2022',
    role: 'VMware Operations Engineer',
    company: 'Ericsson',
    description:
      'Managed network configurations and resolved VMware cloud issues, monitoring resource performance, availability, and latency.',
  },
  {
    period: '2020 — 2021',
    role: 'Freelance Developer',
    company: '',
    description:
      'Built a Synology NAS tool for file uploads, user creation, notifications, and read receipts, plus a Python and pandas app for editing Excel files.',
  },
  {
    period: '2018 — 2021',
    role: 'Accountant & IT Support',
    company: 'Amministrazioni Martellucci',
    description:
      'Managed accounting workflows and improved office processes with Python scripts and Excel tools. Developed downbpiol to automate downloading files from a web service.',
  },
  {
    period: '2010 — 2020',
    role: 'Private Tutor',
    company: '',
    description:
      'Tutored high-school students in English and, primarily, mathematics—work that helped fund my studies and strengthened my communication and teaching skills.',
  },
];

const projects = [
  {
    number: '01',
    name: 'downbpiol',
    type: 'Python · Selenium',
    description:
      'A small tool that automates downloading useful files from the BPIOL website, with a simple interface for everyday use.',
    href: 'https://github.com/ch-pat/downbpiol',
    linkLabel: 'View on GitHub',
  },
  {
    number: '02',
    name: 'xForm / DriveManager',
    type: 'Python · PySimpleGUI',
    description:
      'A desktop application for connecting to a Synology NAS, managing users, and uploading files. The repository is currently private.',
    href: '',
    linkLabel: '',
  },
  {
    number: '03',
    name: 'Table Explorer',
    type: 'Python · pandas · PySimpleGUI',
    description:
      'A desktop application for updating Excel files and managing documents through a more approachable interface.',
    href: 'https://github.com/ch-pat/table-explorer',
    linkLabel: 'View on GitHub',
  },
];

const skills = [
  'Python',
  'Node.js',
  'JavaScript',
  'Java',
  'Go',
  'SQL',
  'Git',
  'Terraform',
  'Google Cloud',
  'Apigee',
  'AWS',
  'Jenkins',
  'Jira',
];

const cvUrl = 'https://github.com/ch-pat/curriculum-vitae/blob/main/EN/main.pdf?raw=true';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Patryk Choma is a software engineer based in Italy, focused on backend development, automation, APIs, and testing."
    />
    <meta name="theme-color" content="#f7f8f6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/favicons/manifest.webmanifest" />
    <title>Patryk Choma — Software Engineer</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Patryk Choma, home">PC<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a class="nav-contact" href="#contact">Get in touch <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero section-wrap" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> Software engineer <span class="eyebrow-divider">/</span> Italy</p>
          <h1 id="hero-title">I build useful software, <span>thoughtfully.</span></h1>
          <p class="hero-intro">
            I’m Patryk Choma. I work on backend services, automation, and the details that make software dependable.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#projects">Explore my work <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="mailto:patryk.choma@gmail.com">Let’s talk <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <aside class="hero-note" aria-label="Areas of focus">
          <span class="note-index">A little about my work</span>
          <p>Backend development</p>
          <p>Automation &amp; tooling</p>
          <p>APIs &amp; testing</p>
          <div class="cv-download">
            <a class="cv-qr-link" href={cvUrl} aria-label="Download Patryk Choma's CV PDF">
              <img src="/CV_QR.png" alt="QR code linking to the CV PDF" width="180" height="180" />
            </a>
            <div class="cv-download-copy">
              <p class="cv-download-label">Curriculum vitae</p>
              <a class="cv-download-link" href={cvUrl}>
                Download CV <span aria-hidden="true">↓</span>
              </a>
            </div>
          </div>
          <div class="note-bottom"><span>Curious by nature</span><span aria-hidden="true">✳</span></div>
        </aside>
        <a class="scroll-cue" href="#about"><span></span> Scroll to explore</a>
      </section>

      <section class="content-section section-wrap" id="about" aria-labelledby="about-title">
        <div class="section-heading">
          <p class="eyebrow">01 <span class="eyebrow-divider">/</span> A bit about me</p>
          <h2 id="about-title">Practical by design.<br /><span>Curious by default.</span></h2>
        </div>
        <div class="about-content">
          <p class="about-lead">
            I’m a software engineer from Italy with a bachelor’s degree in Computer Science. I enjoy solving real-world problems with reliable backends and small, considered tools.
          </p>
          <p class="about-detail">
            My work spans cloud services, network operations, and desktop applications. I value clear interfaces, reliable tests, accountable teamwork, and helping junior colleagues.
          </p>
          <div class="skills" aria-label="Skills">
            {skills.map((skill) => <span class="skill">{skill}</span>)}
          </div>
        </div>
      </section>

      <section class="content-section experience-section" id="experience" aria-labelledby="experience-title">
        <div class="section-wrap">
          <div class="section-heading">
            <p class="eyebrow">02 <span class="eyebrow-divider">/</span> The path so far</p>
            <h2 id="experience-title">Experience</h2>
          </div>
          <div class="timeline">
            {experience.map((item) => (
              <article class="timeline-item">
                <p class="timeline-date">{item.period}</p>
                <div class="timeline-entry">
                  <h3>{item.role}{item.company && <span> · {item.company}</span>}</h3>
                  <p>{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="content-section section-wrap" id="projects" aria-labelledby="projects-title">
        <div class="section-heading project-heading">
          <div>
            <p class="eyebrow">03 <span class="eyebrow-divider">/</span> Selected work</p>
            <h2 id="projects-title">Things I’ve made</h2>
          </div>
          <p class="heading-aside">Small, useful tools<br />built around real needs.</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <div class="project-card-top">
                <span class="project-number">{project.number}</span>
                <span class="project-mark" aria-hidden="true">↗</span>
              </div>
              <p class="project-type">{project.type}</p>
              <h3>{project.name}</h3>
              <p class="project-description">{project.description}</p>
              {project.href ? (
                <a class="project-link" href={project.href} target="_blank" rel="noreferrer">
                  {project.linkLabel} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="project-private">Private project</span>
              )}
            </article>
          ))}
        </div>
      </section>

      <section class="education-band">
        <div class="section-wrap education-content">
          <p class="eyebrow">The foundation</p>
          <div>
            <h2>Bachelor’s degree in Computer Science</h2>
            <p>La Sapienza University of Rome</p>
          </div>
          <span class="education-date">2020</span>
        </div>
      </section>

      <section class="contact-section section-wrap" id="contact" aria-labelledby="contact-title">
        <p class="eyebrow">04 <span class="eyebrow-divider">/</span> Say hello</p>
        <div class="contact-content">
          <h2 id="contact-title">Have a good problem<br />to solve?</h2>
          <a class="contact-email" href="mailto:patryk.choma@gmail.com">
            patryk.choma@gmail.com <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="contact-links">
          <a href="https://github.com/ch-pat" target="_blank" rel="me noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a href="https://linkedin.com/in/p-choma" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          <a href="mailto:patryk.choma@gmail.com">Email <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer section-wrap">
      <a class="wordmark" href="#top">PC<span>.</span></a>
      <p>Designed and built with care.</p>
      <a class="back-to-top" href="#top">Back to top ↑</a>
    </footer>
  </body>
</html>
